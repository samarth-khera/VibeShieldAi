generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum ScanStatus {
  queued
  retrieving
  ready_for_scan
  scanning
  completed
  completed_with_warnings
  cancelled
  invalid_repository
  download_failed
  rejected_by_limits
  failed
}

/// One repository security scan job. Stores metadata and findings only — never raw secrets or repository archives.
model ScanJob {
  /// Non-guessable public identifier (192 bits, base64url). Acts as the access capability.
  id              String     @id @db.VarChar(32)
  status          ScanStatus @default(queued)

  owner           String     @db.VarChar(39)
  repo            String     @db.VarChar(100)
  repositoryUrl   String     @db.VarChar(200)

  // Repository metadata (filled by the worker)
  defaultBranch   String?    @db.VarChar(255)
  commitSha       String?    @db.VarChar(40)
  description     String?    @db.VarChar(500)
  repoSizeKb      Int?
  stars           Int?
  primaryLanguage String?    @db.VarChar(100)

  // Retrieval stats (after bounded download + safe extraction check)
  archiveBytes    Int?
  fileCount       Int?
  unpackedBytes   Int?

  // Failure info (sanitized)
  failureCategory String?    @db.VarChar(40)
  errorMessage    String?    @db.VarChar(300)

  // Scanner status and metrics
  gitleaksStatus     String?    @db.VarChar(30)
  gitleaksDurationMs Int?
  gitleaksError      String?    @db.VarChar(300)

  semgrepStatus      String?    @db.VarChar(30)
  semgrepDurationMs  Int?
  semgrepError       String?    @db.VarChar(300)

  osvStatus          String?    @db.VarChar(30)
  osvDurationMs      Int?
  osvError           String?    @db.VarChar(300)

  scannerVersions    Json?
  scanCoverage       Json?

  criticalCount      Int        @default(0)
  highCount          Int        @default(0)
  mediumCount        Int        @default(0)
  lowCount           Int        @default(0)
  infoCount          Int        @default(0)

  findings           Finding[]
  remediations       Remediation[]

  clientIpHash    String?    @db.VarChar(64)
  workflowRunId   String?    @db.VarChar(100)
  workflowRunUrl  String?    @db.VarChar(300)

  attempts        Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  startedAt       DateTime?
  completedAt     DateTime?
  /// Rows past this time are deleted by the worker's cleanup task.
  expiresAt       DateTime

  @@index([status])
  @@index([expiresAt])
  @@index([owner, repo])
  @@index([createdAt])
  @@index([clientIpHash, createdAt])
}

model Finding {
  id               String    @id @default(cuid()) @db.VarChar(36)
  scanJobId        String    @db.VarChar(32)
  scanJob          ScanJob   @relation(fields: [scanJobId], references: [id], onDelete: Cascade)

  fingerprint      String    @db.VarChar(64)
  scanner          String    @db.VarChar(30)
  ruleId           String    @db.VarChar(120)
  category         String    @db.VarChar(50)
  severity         String    @db.VarChar(20)
  originalSeverity String?   @db.VarChar(50)
  title            String    @db.VarChar(250)
  description      String    @db.Text
  filePath         String    @db.VarChar(500)
  startLine        Int?
  endLine          Int?
  redactedEvidence String?   @db.Text
  vulnerabilityId  String?   @db.VarChar(100)
  remediation      String?   @db.Text
  packageInfo      Json?
  metadata         Json?
  aiExplanation    Json?
  createdAt        DateTime  @default(now())

  @@unique([scanJobId, fingerprint])
  @@index([scanJobId])
  @@index([scanJobId, severity])
  @@index([scanJobId, category])
}

enum RemediationStatus {
  preview
  approved
  applied
  verified
  needs_review
  failed
  rejected
}

model Remediation {
  id                  String            @id @db.VarChar(36)
  scanJobId           String            @db.VarChar(32)
  scanJob             ScanJob           @relation(fields: [scanJobId], references: [id], onDelete: Cascade)

  status              RemediationStatus @default(preview)
  findingFingerprints Json              // Array of targeted fingerprints
  commitSha           String            @db.VarChar(40)

  patchSummary        String            @db.VarChar(500)
  unifiedDiff         String            @db.Text
  affectedFiles       Json              // string[]
  eligibility         String            @db.VarChar(30) // "safe" | "potentially_breaking" | "unsuitable"
  eligibilityReason   String            @db.VarChar(500)
  requiresRotation    Boolean           @default(false)
  warnings            Json?             // string[]

  approvedAt          DateTime?
  approvedOperations  Json?             // details of approved diff operations

  rescanStatus        String?           @db.VarChar(30) // "verified" | "needs_review" | "failed"
  rescanSummary       Json?             // { targetResolved: boolean, newFindingsCount: number }

  branchName          String?           @db.VarChar(120)
  pullRequestUrl      String?           @db.VarChar(300)

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([scanJobId])
  @@index([status])
}

/// Global Gemini circuit breaker persisted across serverless instances in PostgreSQL.
model AiCircuitBreaker {
  id                  String    @id @db.VarChar(32) // "global"
  isOpen              Boolean   @default(false)
  openedAt            DateTime?
  reason              String?   @db.VarChar(50) // "quota_exhausted" | "rate_limited" | "api_error" | "manual"
  message             String?   @db.VarChar(500)
  cooldownUntil       DateTime?
  consecutiveFailures Int       @default(0)
  lastFailureAt       DateTime?
  updatedAt           DateTime  @updatedAt
}

/// Atomic log of on-demand AI requests for enforcing per-IP and global daily quotas.
model AiRequestLog {
  id           String    @id @default(cuid()) @db.VarChar(36)
  clientIpHash String    @db.VarChar(64)
  scanJobId    String?   @db.VarChar(32)
  findingId    String?   @db.VarChar(36)
  action       String    @db.VarChar(30) // "explain" | "remediation"
  success      Boolean   @default(true)
  createdAt    DateTime  @default(now())

  @@index([clientIpHash, createdAt])
  @@index([createdAt])
}

/// Liveness of persistent warm scanner workers. Only used when WARM_WORKER_ENABLED=true.
model WorkerHeartbeat {
  /// Worker identity from its configuration (not secret).
  id                String   @id @db.VarChar(64)
  /// Signed timestamp (ms) of the last accepted request; older or equal timestamps are replays.
  lastRequestMs     BigInt
  lastSeenAt        DateTime
  startedAt         DateTime
  capacity          Int      @default(1)
  activeJobs        Int      @default(0)
  version           String?  @db.VarChar(40)
  arch              String?  @db.VarChar(40)
  scannerVersions   Json?
}

// ---------------------------------------------------------------------------------------------
// GitHub App user authorization. All tables below are only read or written when the GitHub App is
// configured (GITHUB_APP_CLIENT_ID etc.), so deployments without it never touch them.
// ---------------------------------------------------------------------------------------------

/// Browser session. The cookie holds a random token; only its SHA-256 is stored here.
model AuthSession {
  /// SHA-256 (hex) of the session cookie value.
  id              String         @id @db.VarChar(64)
  githubAccountId String?        @db.VarChar(36)
  githubAccount   GithubAccount? @relation(fields: [githubAccountId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  lastSeenAt      DateTime       @default(now())
  expiresAt       DateTime
  revokedAt       DateTime?

  @@index([githubAccountId])
  @@index([expiresAt])
}

/// A GitHub user who authorized the VibeShield GitHub App. Tokens are AES-256-GCM encrypted.
model GithubAccount {
  id                    String        @id @default(cuid()) @db.VarChar(36)
  githubUserId          BigInt        @unique
  login                 String        @db.VarChar(39)
  avatarUrl             String?       @db.VarChar(300)
  accessTokenEnc        String        @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenEnc       String?       @db.Text
  refreshTokenExpiresAt DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  sessions              AuthSession[]
}

/// Single-use OAuth/installation state, bound to the session that started the flow.
model OAuthState {
  /// SHA-256 (hex) of the state value sent to GitHub.
  id              String    @id @db.VarChar(64)
  sessionId       String    @db.VarChar(64)
  purpose         String    @db.VarChar(20) // "connect" | "install"
  returnTo        String    @db.VarChar(300)
  /// PKCE verifier, encrypted.
  codeVerifierEnc String?   @db.Text
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@index([expiresAt])
}

/// Canonical repository identity of a scan, and who may see it when the repository is private.
model ScanAccess {
  scanJobId    String   @id @db.VarChar(32)
  githubRepoId BigInt
  isPrivate    Boolean  @default(false)
  /// GitHub user whose authorization was used to scan a private repository.
  githubUserId BigInt?
  createdAt    DateTime @default(now())

  @@index([githubUserId])
}

/// Security audit trail. Never contains tokens, codes, state values or secrets.
model AuditEvent {
  id            String   @id @default(cuid()) @db.VarChar(36)
  at            DateTime @default(now())
  action        String   @db.VarChar(40)
  outcome       String   @db.VarChar(30)
  githubUserId  BigInt?
  githubLogin   String?  @db.VarChar(39)
  scanJobId     String?  @db.VarChar(32)
  remediationId String?  @db.VarChar(36)
  repository    String?  @db.VarChar(140)
  detail        String?  @db.VarChar(300)

  @@index([at])
  @@index([githubUserId, at])
}
