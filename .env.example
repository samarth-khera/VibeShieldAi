# Copy to .env and adjust. Placeholder values only — never commit real credentials.

# PostgreSQL (docker compose service on loopback port 5442)
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL="postgresql://vibeshield:change-me-local-only@127.0.0.1:5442/vibeshield?schema=public"

# Redis (docker compose service on loopback port 6389)
REDIS_URL="redis://127.0.0.1:6389"

# Optional: GitHub token (no scopes needed for public repos) to raise API rate limits.
# Leave empty for unauthenticated access.
GITHUB_TOKEN=

# Retrieval limits
MAX_ARCHIVE_MB=50
MAX_UNPACKED_MB=200
MAX_FILE_COUNT=10000
MAX_REPO_SIZE_MB=200
RETRIEVAL_TIMEOUT_MS=120000
GITHUB_API_TIMEOUT_MS=15000

# Rate limiting for POST /api/scans (per client IP, per window)
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=3600

# Worker
WORKER_CONCURRENCY=2
JOB_TTL_HOURS=24
